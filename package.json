{
  "name": "scripture-in-music-offline",
  "main": "electron/main.cjs",
  "private": true,
  "version": "0.1.0",
  "description": "Free, non-commercial offline scripture memorization and music practice software.",
  "author": "Harris Software Solutions LLC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint electron/main.cjs electron/preload.cjs src/config src/services src/data/arrangements src/components/ScriptureComposer.tsx src/components/DonationLinks.tsx src/components/SocialMediaIntegration.tsx src/components/OfflineStatus.tsx",
    "lint:legacy": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.yml",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "package:external": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-external.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-share": "^5.2.2",
    "soundfont-player": "^0.12.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@capacitor/cli": "^7.0.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
